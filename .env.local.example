# Supabase — from the project's API settings
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Required for username/password registration and cron jobs. Keep server-only.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# REQUIRED for the cron routes. They run with the service role (RLS bypass), so
# they fail CLOSED when this is unset: without it /api/cron/* returns 401.
CRON_SECRET=GENERATE-A-LONG-RANDOM-STRING

# REQUIRED to connect an invoicing integration. Integration credentials are
# sealed with AES-256-GCM using this key before they are stored, so a database
# read alone never yields a usable API key. 64 hex characters (32 bytes):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing this key means existing connections must be re-connected.
CREDENTIALS_KEY=64-HEX-CHARACTERS

# ---------- Outbound reminder channels ----------
# Optional, and the sweep sends nothing without at least one of them. Note how
# each channel fails when half-configured: it is skipped BEFORE it attempts
# anything, so reminder_log stays empty rather than filling with failures —
# which is why /admin reports configured channels and subscribed devices
# explicitly instead of leaving an empty log to be interpreted.
#
# Email needs both of these.
# RESEND_API_KEY=
# REMINDER_FROM_EMAIL=
# WhatsApp needs all three. The template name is not optional: Meta delivers a
# business-initiated message only through a pre-approved template, and a
# deadline reminder is never inside the 24-hour window the plain-text fallback
# requires — without a template the API returns 200 and nothing arrives, so
# whatsappConfigured() deliberately refuses to call the channel ready.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE_NAME=
#
# Push needs all four. The first three are the sender; the fourth is the only
# thing that makes the subscribe button appear in settings, and with no
# subscribed browser the keys reach nobody however correct they are. Generate a
# pair with:  npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY and NEXT_PUBLIC_VAPID_PUBLIC_KEY take the SAME value.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ---------- Billing (Stripe) ----------
# Until all three are set, the upgrade button tells the user that Pro is not
# open yet rather than sending them into a broken flow. Subscription state is
# written ONLY by the verified webhook — migration 019 enforces that in the
# database, so no client path can grant Pro even if these are set.
STRIPE_SECRET_KEY=
# The recurring price to subscribe to (price_..., not prod_...).
STRIPE_PRICE_ID=
# From `stripe listen` locally, or the endpoint's signing secret in the
# dashboard. Without it the webhook rejects every request, which is the correct
# failure mode for a public endpoint that grants paid access.
STRIPE_WEBHOOK_SECRET=
