# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...and the example IS opted in. ".env*" swallowed it, so the one file whose
# whole purpose is to be read by the next person was never in the repo: the
# audit's fix for the fail-open cron routes was "document CRON_SECRET in
# .env.local.example", and that documentation has been sitting untracked on one
# machine ever since. It contains placeholders only, never a value — the repo
# is public, and env-documented.test.ts reads this file, so a fresh clone
# without it fails the build rather than losing the instructions again.
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
